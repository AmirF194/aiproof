# Copy this to .env and fill in. .env is gitignored.
# In production on fastinfer, /opt/aiproof/.env holds the real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=aiproof.fastinfer.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://aiproof.fastinfer.org,http://localhost:9012

# --- Postgres ---
POSTGRES_DB=aiproof
POSTGRES_USER=aiproof
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgres://aiproof:change-me-in-production@db:5432/aiproof

# --- Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# --- Container ports / commands ---
AIPROOF_HOST_PORT=9012
# AIPROOF_API_CMD=gunicorn aiproof.wsgi:application --bind 0.0.0.0:8000 --workers 3 --access-logfile -

# --- Entrypoint flags ---
DJANGO_MIGRATE_ON_START=1
DJANGO_COLLECTSTATIC_ON_START=1
DJANGO_LOAD_ROLES_ON_START=1
