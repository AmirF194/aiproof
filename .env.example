# Copy this to .env and fill in. .env is gitignored.
# In production on fastinfer, /opt/aiproof/.env holds the real values.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=aiproof.fastinfer.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://aiproof.fastinfer.org,http://localhost:9012

# --- Postgres ---
POSTGRES_DB=aiproof
POSTGRES_USER=aiproof
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgres://aiproof:change-me-in-production@db:5432/aiproof

# --- Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# --- Container ports / commands ---
AIPROOF_HOST_PORT=9012
# AIPROOF_API_CMD=gunicorn aiproof.wsgi:application --bind 0.0.0.0:8000 --workers 3 --access-logfile -

# --- Entrypoint flags ---
DJANGO_MIGRATE_ON_START=1
DJANGO_COLLECTSTATIC_ON_START=1
DJANGO_LOAD_ROLES_ON_START=1

# --- Crawler API keys (optional; each crawler skips gracefully if unset) ---
# Adzuna — 250 calls/day free. Register at developer.adzuna.com.
# ADZUNA_APP_ID=
# ADZUNA_API_KEY=
#
# USAJobs.gov Search API — free. Register at developer.usajobs.gov.
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=contact@fastinfer.org
#
# BLS Public Data API — works without a key (25 queries/day cap).
# Register at data.bls.gov/registrationEngine to lift the cap to 500/day.
# BLS_API_KEY=
#
# Reed.co.uk API — 1,000 calls/day free. Register at www.reed.co.uk/developers/jobseeker.
# REED_API_KEY=
#
# O*NET Web Services — free. Register at services.onetcenter.org.
# ONET_USER=
# ONET_PASS=
